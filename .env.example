# LEARNOTECH SOLUTIONS - ENVIRONMENT VARIABLES

# Port for the Node server (default: 8080)
PORT=8080

# Admin Authentication
LEARNOTECH_ADMIN_USERNAME=Kevin
LEARNOTECH_ADMIN_PASSWORD=12345678

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API:
# https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
# Use the service_role secret key for full backend database and storage access
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Storage bucket name configured in Supabase (default: learnotech-media)
SUPABASE_STORAGE_BUCKET=learnotech-media

# Optional Local SQLite Fallback Settings (used automatically if SUPABASE_URL is not provided)
# DATA_DIR=./data
# DATABASE_FILE=./data/learnotech.sqlite
